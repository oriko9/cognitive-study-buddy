# Copy to .env.local and fill in. .env* files are gitignored; never commit real values.

# --- Client (Vite inlines these into the browser bundle: public by design) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Vercel environment variable, never exposed to the browser) ---
# GEMINI_API_KEY must NEVER carry a VITE_ prefix. Vite inlines every VITE_
# variable into the client bundle, so VITE_GEMINI_API_KEY would publish the key
# to every visitor. Criterion N1 in specs/framing.md; enforced by
# npm run check:secrets and by readServerEnv in src/lib/env.ts.
GEMINI_API_KEY=
